{
  "manifestVersion": 2,
  "id": "snippets",
  "name": "Snippets",
  "version": "0.1.0",
  "description": "Save reusable commands and prompts, search them, and send them to a terminal or copy them in one click.",
  "license": "MIT",
  "repository": "https://github.com/chrisluo5311/orca-snippet",
  "engines": {
    "orca": ">=1.4.247"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "snippets",
        "title": "Snippets",
        "icon": "copy",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "terminal:send" }
  ]
}
